# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high              # low | medium | high | xhigh | max
AGENT_MAX_STEPS=25             # model calls per turn
SHELL_SANDBOX=./sandbox        # the agent's working directory
SHELL_EXECUTABLE=              # empty = auto-detect bash (Git Bash on Windows)
SHELL_COMMAND_TIMEOUT=60       # seconds before a command is killed
SHELL_APPROVAL_MODE=ask        # ask | auto | readonly
LOG_LEVEL=INFO
